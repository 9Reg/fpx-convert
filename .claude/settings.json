{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.sh",
            "timeout": 30,
            "statusMessage": "Checking branch and fmt"
          }
        ]
      }
    ]
  }
}
