{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build fpx-convert (debug)",
            "type": "shell",
            "command": "cargo build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build fpx-convert (release)",
            "type": "shell",
            "command": "cargo build --release",
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build fpx-convert (production, x86_64 + arm64)",
            "type": "shell",
            "command": "./scripts/build-release.sh",
            "group": "build",
            "problemMatcher": ["$rustc"]
        }
    ]
}
